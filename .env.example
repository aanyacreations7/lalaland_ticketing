# Copy this file to .env (same folder as index.php) and fill in your keys.
# .env is never committed to git and .htaccess blocks it from the web.
# Razorpay Dashboard → Account & Settings → API Keys (test keys start rzp_test_, live keys rzp_live_)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
# Server only. Never put the secret in JavaScript or HTML.
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard → Webhooks: the secret you typed when adding /webhook.php
RAZORPAY_WEBHOOK_SECRET=
